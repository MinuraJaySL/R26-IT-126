# Copy this file to `.dev.vars` (gitignored) for local `wrangler dev` testing.
# In production these are set with `wrangler secret put <NAME>`, not in a file.

# Paste the FULL service account JSON on one line (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key).
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# EmailJS -> Account -> API Keys -> Private Key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Shared secret the IoT bin devices (ESP32) send in the X-Device-Secret
# header to /bin-status. Make up any long random string — this isn't tied
# to any external service, just a password only this Worker and the
# devices know.
BIN_DEVICE_SECRET=choose_a_long_random_string
