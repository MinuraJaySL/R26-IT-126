rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDriver() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Each user can read their own profile doc; admins can read any profile
    // (User Management screen). Self-signup may create its own doc but only
    // ever as a resident (server also hardcodes this — see cf-worker). A
    // user may update their own doc (email, fcmToken, etc) but can never
    // change their own `role` — that would be self-elevation. Admins may
    // update any user's doc, including role. Only admins may delete users.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'resident');

      // A user may update their own doc (name, phone, fcmToken, etc) but can
      // never change their own role (self-elevation) or disabled flag
      // (self-reactivating an account an admin disabled). .get(...) with a
      // default avoids an eval error on older docs written before the
      // `disabled` field existed. Admins may change either.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('disabled', false) == resource.data.get('disabled', false)) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Any signed-in user can read bin data (driver map). Only drivers can seed/update bins.
    match /bins/{binId} {
      allow read: if isSignedIn();
      allow write: if isDriver();
    }

    // Residents create/own their pickup requests; drivers can read/update any of them
    // (mark arrived, reactivate missed). Residents can update only their own request's status.
    match /pickupRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.residentId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.residentId == request.auth.uid || isDriver());

      // Residents may delete their own request to undo a mistake, but only
      // within 10 minutes of placing it and only while it's still `active`
      // (once a driver has responded — arrived/etc — it's too late to undo).
      allow delete: if isSignedIn() &&
        resource.data.residentId == request.auth.uid &&
        resource.data.status == 'active' &&
        request.time < resource.data.createdAt + duration.value(10, 'm');
    }

    // Residents report a bin problem (overflow, damage, etc) with a location
    // + note; any driver can pick it up and resolve it. Residents can't edit
    // or delete after submitting, and can't resolve their own report.
    match /binReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.residentId == request.auth.uid;
      allow update: if isDriver();
      allow delete: if false;
    }

    // A disabled account (still able to authenticate — the app's router
    // gate is what blocks them, not sign-in) may file exactly one recovery
    // request for itself; only admin can read or resolve it.
    match /accountRecoveryRequests/{requestId} {
      // Admin reads any request (to resolve it); the submitter can read
      // their own back (AccountDisabledScreen shows a denial's note).
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Drivers publish their own live GPS position; any signed-in user may read it.
    match /driverLocations/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == driverId;
    }

    // Signup email-verification codes. Only touched by Cloud Functions via
    // the Admin SDK (which bypasses these rules) — never directly by clients.
    match /emailVerifications/{email} {
      allow read, write: if false;
    }

    // IP-based rate-limit counters for /request-code. Same reasoning as
    // emailVerifications above — only the Worker's service-account token
    // (which bypasses these rules) ever touches this collection.
    match /rateLimits/{ip} {
      allow read, write: if false;
    }
  }
}
