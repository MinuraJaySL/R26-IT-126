rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Signed in with a profile an admin hasn't disabled. A disabled account
    // can still authenticate (the app's router is what parks it on the
    // "account disabled" screen), so everything except its own profile and
    // its recovery request is closed to it here rather than trusting that
    // screen. .get(...) with a default covers docs written before the
    // `disabled` field existed.
    function isActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().get('disabled', false) == false;
    }

    function isDriver() {
      return isActive() && myProfile().role == 'driver';
    }

    function isAdmin() {
      return isActive() && myProfile().role == 'admin';
    }

    // Each user can read their own profile doc; admins can read any profile
    // (User Management screen). Self-signup may create its own doc but only
    // ever as a resident (server also hardcodes this — see cf-worker). A
    // user may update their own doc (email, fcmToken, etc) but can never
    // change their own `role` — that would be self-elevation. Admins may
    // update any user's doc, including role. Only admins may delete users.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'resident');

      // A user may update their own doc (name, phone, fcmToken, etc) but can
      // never change their own role (self-elevation) or disabled flag
      // (self-reactivating an account an admin disabled). .get(...) with a
      // default avoids an eval error on older docs written before the
      // `disabled` field existed. Admins may change either.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('disabled', false) == resource.data.get('disabled', false)) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Any active user can read bin data (driver map). Only drivers can seed/update bins.
    match /bins/{binId} {
      allow read: if isActive();
      allow write: if isDriver();
    }

    // A resident sees only their own pickup requests — each one carries
    // their location — while drivers and admins see all of them. The app's
    // resident queries filter on residentId, which is what lets Firestore
    // accept them under this rule.
    //
    // A request always starts out `active` under its creator's own id.
    // After that nobody can move it, re-date it or hand it to someone else:
    // an update may only touch the fields named below.
    //   - The resident may only answer an arrival (`arrived` -> `collected`
    //     or `missed`) or let an unanswered request lapse (`active` ->
    //     `expired`) — see MyPickupsScreen and autoResolveStaleRequests.
    //     They can't mark a request collected before a truck has arrived.
    //   - A driver may change the status and the arrival stamp (mark
    //     arrived, reactivate a missed request, the same auto-resolve).
    match /pickupRequests/{requestId} {
      allow read: if isActive() &&
        (resource.data.residentId == request.auth.uid || isDriver() || isAdmin());
      allow create: if isActive() &&
        request.resource.data.residentId == request.auth.uid &&
        request.resource.data.status == 'active';
      allow update: if isActive() && (
        (resource.data.residentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'autoMissed']) &&
          ((resource.data.status == 'active' &&
              request.resource.data.status == 'expired') ||
            (resource.data.status == 'arrived' &&
              request.resource.data.status in ['collected', 'missed']))) ||
        (isDriver() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'autoMissed', 'arrivedAt', 'arrivedByDriverId']))
      );

      // Residents may delete their own request to undo a mistake, but only
      // within 10 minutes of placing it and only while it's still `active`
      // (once a driver has responded — arrived/etc — it's too late to undo).
      allow delete: if isActive() &&
        resource.data.residentId == request.auth.uid &&
        resource.data.status == 'active' &&
        request.time < resource.data.createdAt + duration.value(10, 'm');
    }

    // Residents report a bin problem (overflow, damage, etc) with a location
    // + note; any driver can pick it up and resolve it. Residents can't edit
    // or delete after submitting, and can't resolve their own report. Like
    // pickup requests, a resident sees only their own reports, and a report
    // always starts out `open`.
    match /binReports/{reportId} {
      allow read: if isActive() &&
        (resource.data.residentId == request.auth.uid || isDriver() || isAdmin());
      allow create: if isActive() &&
        request.resource.data.residentId == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isDriver();
      allow delete: if false;
    }

    // A disabled account (still able to authenticate — the app's router
    // gate is what blocks them, not sign-in) may file exactly one recovery
    // request for itself; only admin can read or resolve it.
    match /accountRecoveryRequests/{requestId} {
      // Admin reads any request (to resolve it); the submitter can read
      // their own back (AccountDisabledScreen shows a denial's note).
      allow read: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Drivers publish their own live GPS position; any active user may read it.
    // Only a driver may publish one — otherwise any account could put a fake
    // truck on residents' maps.
    // `mode` is what residents' Track Truck filters on ('pickups' only) — a
    // driver writing anything else there would silently vanish from tracking,
    // so it's constrained here rather than trusted client-side.
    match /driverLocations/{driverId} {
      allow read: if isActive();
      allow create, update: if isDriver() && request.auth.uid == driverId &&
        request.resource.data.mode in ['bins', 'pickups'] &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number;
      allow delete: if isDriver() && request.auth.uid == driverId;
    }

    // Signup email-verification codes. Only touched by Cloud Functions via
    // the Admin SDK (which bypasses these rules) — never directly by clients.
    match /emailVerifications/{email} {
      allow read, write: if false;
    }

    // IP-based rate-limit counters for /request-code. Same reasoning as
    // emailVerifications above — only the Worker's service-account token
    // (which bypasses these rules) ever touches this collection.
    match /rateLimits/{ip} {
      allow read, write: if false;
    }

    // Driver posts "truck coming to this ward on this date"; any signed-in
    // user can read (residents filter client-side to their own ward).
    // `sent` is flipped only by the Worker's scheduled handler (service
    // account, bypasses these rules) once the fixed-time push actually
    // goes out — a client can only ever write it as false.
    //
    // The app uses a deterministic doc id per ward+date, so there is one
    // announcement per ward per date and a later post is an update of the
    // same doc: the latest details win. Any driver may post that update
    // (not only the original author — it's whoever has the newer
    // information), but it must be under their own id, can't move to a
    // different ward/date, and always goes back to un-sent so the Worker
    // sends the new details.
    //
    // `isUpdate` is decided here, not by the client: it's true exactly when
    // the doc being replaced had already been sent (or was itself such an
    // update). That flag is what lets the Worker send it immediately instead
    // of waiting for 6 PM, so a first announcement can never claim it.
    //
    // A driver may cancel (delete) their own announcement, but only while
    // it's still un-sent and isn't an update — once residents have been
    // notified there's nothing left to take back.
    match /collectionAnnouncements/{id} {
      allow read: if isActive();
      allow create: if isDriver() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.sent == false &&
        request.resource.data.get('isUpdate', false) == false;
      allow update: if isDriver() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.sent == false &&
        request.resource.data.ward == resource.data.ward &&
        request.resource.data.collectionDate == resource.data.collectionDate &&
        request.resource.data.get('isUpdate', false) ==
          (resource.data.sent == true || resource.data.get('isUpdate', false) == true);
      allow delete: if isDriver() &&
        resource.data.driverId == request.auth.uid &&
        resource.data.sent == false &&
        resource.data.get('isUpdate', false) == false;
    }

    // In-app notification inbox — written only by the Worker (service
    // account, bypasses these rules) alongside each FCM push, so a record
    // survives even if the push itself was missed. A user may read their
    // own notifications and flip `read`, but can't touch anything else
    // about them (title/body/type/relatedId/userId must stay unchanged) —
    // and can never create or delete one directly.
    match /notifications/{id} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.relatedId == resource.data.relatedId;
      allow create, delete: if false;
    }
  }
}
